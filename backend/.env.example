# Set to prod on the Droplet's .env to use config/settings/prod.py instead
# of dev.py (currently identical behavior - see config/settings/__init__.py).
DJANGO_ENV=dev

SECRET_KEY=change-me
DEBUG=True
# 10.0.2.2 is the Android emulator's alias for the host machine - needed for the mobile app to reach this server locally
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DB_NAME=lab_expertgg
DB_USER=lab_expertgg
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=True

# Personal token from https://app.pandascore.co/dashboard
PANDASCORE_API_KEY=change-me
# Comma-separated PandaScore videogame slugs to sync, e.g. cs-go,league-of-legends
PANDASCORE_GAMES=cs-go

# Set to False on the Droplet's .env only until a domain + TLS cert exist -
# forcing HTTPS before that would make the site unreachable. Remove this
# line (or set True) once HTTPS is actually live.
FORCE_HTTPS=True
