# Set to prod on the Droplet's .env to use config/settings/prod.py instead
# of dev.py (currently identical behavior - see config/settings/__init__.py).
DJANGO_ENV=dev

SECRET_KEY=change-me
DEBUG=True
# 10.0.2.2 is the Android emulator's alias for the host machine - needed for the mobile app to reach this server locally
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DB_NAME=lab_expertgg
DB_USER=lab_expertgg
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=True
